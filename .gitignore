# Lista de liberação: TUDO fica fora do repositório, exceto o que está liberado abaixo (linhas com "!").
# Assim, arquivos novos (manuais, roteiros, acessos.txt...) nunca sobem por engano.
/*

# Documentação
!/.gitignore
!/README.md
!/dataset_manual.docx
!/dataset_dicionario_observatorio_tabelas_buscas_nichos.docx

# App dos painéis (Streamlit Cloud)
!/requirements.txt
!/app.py
!/painel_comum.py
!/estatistica.py
!/inferencia.py
!/paginas/
/paginas/*
!/paginas/*.py
!/.streamlit/
/.streamlit/*
!/.streamlit/config.toml

# Scripts de reprodução da amostra (tamanho e sorteio)
!/calcular_tamanho_amostra.py
!/sortear_amostra.py

# Dados
!/dataset.txt
!/amostra.txt

# Nunca, em nenhuma pasta
__pycache__/
secrets.toml
